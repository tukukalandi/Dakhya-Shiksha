rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'tukukalandi@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isIncrementOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount', 'downloadCount'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['viewCount']) || request.resource.data.viewCount >= resource.data.viewCount)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['downloadCount']) || request.resource.data.downloadCount >= resource.data.downloadCount);
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /studyMaterials/{materialId} {
      allow read: if (resource != null && resource.data.isPublished == true) || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (resource != null && resource.data.isPublished == true && isIncrementOnly());
    }

    match /videos/{videoId} {
      allow read: if (resource != null && (resource.data.status == 'published' || resource.data.status == 'active')) || isAdmin();
      allow write: if isAdmin();
    }

    match /quizzes/{quizId} {
      allow read: if (resource != null && resource.data.isPublished == true) || isAdmin();
      allow write: if isAdmin();
    }

    match /classes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subjects/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /materialTypes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /exams/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /olympiads/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
